{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"@/*": ["./*"]
		},
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"nativewind-env.d.ts",
		"services/websocketManager.js",
		"src/theme/colors.js",
		"global.d.ts"
	]
}
